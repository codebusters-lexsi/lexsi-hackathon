# API Keys for Synthetic Generation (OpenAI or Anthropic)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face Hub (Read & Write permissions required to push datasets and models)
HF_TOKEN=your_huggingface_write_token_here
HF_USERNAME=your_hf_username

# Optional Cohere API Key if querying Cohere hosted endpoints
COHERE_API_KEY=your_cohere_api_key_here

# Pipeline Settings
BASE_MODEL_NAME=CohereLabs/tiny-aya-global
WANDB_PROJECT=lexsi-safety-alignment
